<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="PowerGridScadaDB"
         connectionString="Data Source=.;Initial Catalog=PowerGridScadaDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PollingIntervalMs" value="2000" />
    <add key="OverloadThresholdPercent" value="85.0" />
  </appSettings>
</configuration>
